# Copy this file to `.env` (used by Docker Compose) or `.env.local` (used by `pnpm dev`)
# and fill in the values. Never commit the real file.

# --- Supabase (Project Settings -> API) --------------------------------------
# Public values: compiled into the browser bundle at BUILD time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret: server only. Used to render/archive approved reports. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Drive archive (optional; "Approve & Push" is disabled without it) --
# ID of the Drive folder (preferably inside a Shared Drive) the service account can write to.
GOOGLE_DRIVE_FOLDER_ID=
# The service account key JSON on ONE line.
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Gemini AI auto-fill (optional; "Auto-Fill with AI" is disabled without it) -
GOOGLE_GEMINI_API_KEY=
# Model name, change when Google retires a model.
GEMINI_MODEL=gemini-2.5-flash

# --- Docker only --------------------------------------------------------------
# Host port the app is published on.
APP_PORT=3000

# --- Public address -------------------------------------------------------------
# The URL people use to open DeptDocs, e.g. https://deptdocs.christuniversity.in
# REQUIRED for links in notification emails (without it emails have no link).
# Also used for login redirects; if empty those use the Host header.
SITE_URL=

# --- Email notifications (optional; without SMTP only in-app notifications) ------
# Gmail/Google Workspace: smtp.gmail.com, port 587, an App Password.
# Microsoft 365: smtp.office365.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to recipients, e.g. DeptDocs <deptdocs@christuniversity.in>
SMTP_FROM=
# Optional: lets a scheduler call POST /api/notifications/dispatch to retry unsent
# emails (Authorization: Bearer <CRON_SECRET>). Any long random string.
CRON_SECRET=
# Set to true only when DeptDocs runs behind a reverse proxy that sets/overwrites
# X-Forwarded-Host / X-Forwarded-Proto. Not needed when SITE_URL is set.
TRUST_PROXY_HEADERS=
